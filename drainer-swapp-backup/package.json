  "version": "1.0.0",
  "homepage": "./",
  "private": true,
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.21.0",
    "@solana/web3.js": "^1.91.0",
    "@tanstack/react-query": "^5.0.0",
    "@wallet-standard/app": "^1.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "tronweb": "^5.3.1",
    "viem": "^2.0.0",
    "wagmi": "^2.0.0"
  },
  "devDependencies": {
    "ajv": "8.12.0",
    "ajv-formats": "2.1.1"
